    <meta name="keywords" content="{% ta %}LANBucket, file sharing, local network, distributed, LAN, Windows, LAN party, peer to peer, P2P, file transfer, Windows app, network sharing, offline file sharing, share files between computers, transfer large files, game file sharing, share games on LAN, BitTorrent local, local file sync, WiFi file transfer, no cloud file sharing, private file sharing, share files without internet, home network file sharing, fast file transfer, drag and drop file sharing, Windows 10 file sharing, Windows 11 file sharing, free file sharing app, share files same network, LAN file transfer, multiplayer game sharing, Steam game sharing alternative, share files at LAN party, network file transfer tool, 局域网文件传输, 局域网文件共享, 局域网共享文件, 电脑之间传文件, 局域网传文件工具, 点对点文件传输, P2P文件传输, 大文件传输, 无需网络文件共享, 无需联网传文件, WiFi文件传输, 免费文件传输工具, Windows文件共享软件, 局域网聚会文件共享, 游戏文件共享, Steam游戏共享, 局域网快速传文件, 内网文件传输{% endta %}">
    <meta name="author" content="Justin Becker">
    <meta name="robots" content="index, follow">
    <meta name="language" content="{{ locale.englishName }}">
    <meta name="revisit-after" content="7 days">
    <meta name="category" content="Utilities">
    <meta name="coverage" content="Worldwide">
    <meta name="distribution" content="Global">
    <meta name="rating" content="General">
    <meta name="subject" content="{% ta %}Local network file sharing application for Windows{% endta %}">

{% include "alternates.njk" %}

    <!-- Open Graph / Facebook -->
