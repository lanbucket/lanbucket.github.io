    <meta property="og:description" content="{% ta %}Free LAN party file sharing for Windows. Move large game files between every PC on your local network with distributed transfers. No account, no internet required.{% endta %}">
    <meta property="og:image" content="https://lanbucket.com/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{% ta %}LANBucket - Local Network File Sharing App{% endta %}">
    <meta property="og:site_name" content="LANBucket">
{% include "og-locales.njk" %}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="https://lanbucket.com{{ locale.path }}">
    <meta name="twitter:title" content="{% ta %}LAN Party File Sharing App | LANBucket{% endta %}">
    <meta name="twitter:description" content="{% ta %}Free LAN party file sharing for Windows. Move large game files between every PC on your local network with distributed transfers. No account, no internet required.{% endta %}">
    <meta name="twitter:image" content="https://lanbucket.com/og-image.png">
    <meta name="twitter:image:alt" content="{% ta %}LANBucket - Local Network File Sharing App{% endta %}">

{% include "icons.njk" %}

    <!-- Structured Data / JSON-LD -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "LANBucket",
        "alternateName": "{% tj %}LAN Party File Sharing App{% endtj %}",
        "inLanguage": "{{ locale.code }}",
        "description": "{% tj %}LANBucket is a free LAN party file sharing app that moves large game files between every PC on your local network using distributed transfers. No account and no internet required.{% endtj %}",
        "url": "https://lanbucket.com{{ locale.path }}",
        "image": "https://lanbucket.com/logo.svg",
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "Windows 10, Windows 11",
        "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
        },
        "author": {
            "@type": "Person",
            "name": "Justin Becker",
            "url": "https://justinbecker.dev",
            "sameAs": [
                "https://github.com/geekman7473",
                "https://www.linkedin.com/in/justin-t-becker"
            ],
            "description": "{% tj %}Software developer and longtime LAN party host, and the creator of LANBucket.{% endtj %}"
        },
        "softwareVersion": "1.0",
        "featureList": [
            "{% tj %}Local network file sharing{% endtj %}",
            "{% tj %}Automatic device discovery{% endtj %}",
            "{% tj %}Drag and drop interface{% endtj %}",
            "{% tj %}No internet required{% endtj %}",
            "{% tj %}Free to use{% endtj %}",
            "{% tj %}LAN party file sharing{% endtj %}",
            "{% tj %}Share large game files{% endtj %}",
            "{% tj %}Distributed transfer technology{% endtj %}",
            "{% tj %}Fast WiFi file transfer{% endtj %}",
            "{% tj %}Private and secure{% endtj %}",
            "{% tj %}No cloud storage needed{% endtj %}",
            "{% tj %}Progress tracking{% endtj %}",
            "{% tj %}Multiple device support{% endtj %}"
        ],
        "keywords": "{% tj %}file sharing, LAN party, local network, P2P, game sharing, Windows file transfer, 局域网文件传输, 局域网文件共享, 电脑之间传文件, 点对点文件传输, 大文件传输, 游戏文件共享, WiFi文件传输{% endtj %}"
    }
    </script>

    <!-- FAQ Structured Data / JSON-LD -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "inLanguage": "{{ locale.code }}",
        "mainEntity": [
            {
                "@type": "Question",
                "name": "{% tj %}Does LANBucket work over the internet?{% endtj %}",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "{% tj %}No, LANBucket only works on local networks. All devices must be connected to the same WiFi network or Ethernet LAN. This is by design to keep your files private and secure.{% endtj %}"
                }
            },
            {
                "@type": "Question",
                "name": "{% tj %}Will it work on my corporate network?{% endtj %}",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "{% tj %}Many corporate networks block client-to-client communication for security reasons, which may prevent LANBucket from working properly. LANBucket is designed primarily for home and private networks.{% endtj %}"
                }
            },
            {
                "@type": "Question",
                "name": "{% tj %}If multicast is blocked, will LANBucket still work?{% endtj %}",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "{% tj %}Yes, probably. LANBucket has a fallback peer discovery mechanism using a central server, so even if multicast is blocked on your network, devices can still find each other and share files. If this mechanism doesn't work, you can connect to peers by manually entering the IP address of the device you want to connect to.{% endtj %}"
                }
            },
            {
                "@type": "Question",
                "name": "{% tj %}All of my clients are on the same Wifi network, but some of them can't see each other. Why?{% endtj %}",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "{% tj %}Many WiFi routers have \"AP isolation\" or \"client isolation\" features that prevent devices connected to the same WiFi network from communicating with each other. Check your router settings to see if this feature is enabled. Also, we have seen some cases where some wireless routers/access points don't allow client-to-client traffic if they are on different frequency bands, ie. if one client is connected to 2.4GHz and another client is connected to 5GHz. If possible, try connecting all clients to the same frequency band on your WiFi network, or connect them via Ethernet for best results.{% endtj %}"
                }
            },
            {
                "@type": "Question",
                "name": "{% tj %}Can I use it with a VPN?{% endtj %}",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "{% tj %}VPN connections may interfere with local network discovery. You may need to disconnect from your VPN to use LANBucket.{% endtj %}"
                }
            },
            {
                "@type": "Question",
                "name": "{% tj %}What happens if I modify a shared file?{% endtj %}",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "{% tj %}Moving, deleting, or modifying a file that you're sharing will prevent others from downloading it. Keep shared files in place until others have completed their downloads.{% endtj %}"
                }
            },
            {
                "@type": "Question",
                "name": "{% tj %}Is my firewall going to block LANBucket?{% endtj %}",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "{% tj %}Windows Defender Firewall may block LANBucket from discovering devices. Make sure that you have set the network profile to \"Private\" and allowed LANBucket through the firewall when prompted on first launch.{% endtj %}"
                }
            },
            {
                "@type": "Question",
                "name": "{% tj %}Is there Linux or macOS support?{% endtj %}",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "{% tj %}Not yet, but we are considering it. At present LANBucket is built using Windows-specific UI frameworks, so Linux/macOS support would require substantial rework. Unfortunately, LANBucket is not compatible with Wine/Proton either, since we use Windows APIs that are not implemented there either.{% endtj %}"
                }
            },
            {
                "@type": "Question",
                "name": "{% tj %}What is on-the-fly compression?{% endtj %}",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "{% tj %}LANBucket automatically compresses files as they're sent and decompresses them as they arrive, all in real time. You don't have to zip anything up first. For files that compress well, like some video games, you may be able to observe significantly faster transfer speeds. If a file does not compress well, compression is turned off automatically.{% endtj %}"
                }
            },
            {
                "@type": "Question",
                "name": "{% tj %}Is LANBucket free?{% endtj %}",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "{% tj %}Yes! LANBucket is completely free to use, and we're committed to keeping it ad-free. If you'd like to support development, you can buy us a coffee. Your support is appreciated but never required.{% endtj %}"
                }
            },
            {
                "@type": "Question",
                "name": "{% tj %}I found a bug, translation error, or have a feature request. Where do I report it?{% endtj %}",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "{% tj %}We'd love to hear from you! Please fill out the feedback form with details. We review all submissions and appreciate your feedback.{% endtj %}"
                }
            }
        ]
    }
    </script>

    <!-- The video poster is the largest thing on screen (the LCP element), so fetch it right away -->
    <link rel="preload" as="image" href="/lanbucket-demo-poster_{{ video }}.webp" type="image/webp" fetchpriority="high">
    <link rel="stylesheet" href="/style.css">
{% include "head-scripts.njk" %}
</head>
<body>
{% include "header.njk" %}

    <main>
        <!-- Hero Section -->
        <section class="hero">
            <div class="container">
                <div class="hero-content">
                    <div class="hero-layout">
                        <div class="hero-copy">
                            <h1>{% t %}LAN Party File Sharing<br>Made Simple{% endt %}</h1>
                            <p class="hero-description">
                                {% t %}LANBucket is specifically optimized for use at LAN parties, and sharing large files as fast as possible. No internet required.{% endt %}
                            </p>
                            <p class="hero-meta">
                                {% t %}Distributed transfers. <a href="https://en.wikipedia.org/wiki/Electron_(software_framework)" target="_blank" rel="noopener noreferrer">100% Electron-free</a>.{% endt %}
                            </p>
                            <div class="cta-buttons hero-cta-buttons">
                                <div class="hero-download-row">
                                    <!-- Links to the offline installer once the update feed loads, the download page until then -->
                                    <a class="hero-download-btn" id="heroSetup" href="{{ locale.path }}download/">{% t %}Download Installer{% endt %}</a>
                                    <ms-store-badge
                                        productid="9N9WTBT332JN"
                                        window-mode="full"
                                        theme="light"
                                        size="small"
                                        language="{{ locale.storeLanguage }}"
                                        animation="off">
                                    </ms-store-badge>
                                    <a class="hero-download-btn" href="{{ locale.path }}download/">{% t %}More options{% endt %}</a>
                                </div>
                                <div class="hero-download-meta">
                                    <p class="hero-version" id="heroVersion" data-label="{% ta %}Version {version}{% endta %}">&nbsp;</p>
                                    <a class="hero-more-link" href="/changelog.html"{{ enOnly | safe }}>{% t %}Changelog{% endt %}</a>
                                </div>
                            </div>
                        </div>

                        <div class="hero-visual">
                            <div class="hero-video-frame">
                                <video class="hero-video" controls playsinline preload="none" poster="/lanbucket-demo-poster_{{ video }}.webp" aria-label="{% ta %}LANBucket demo video{% endta %}">
                                    <source src="/lanbucket-demo_{{ video }}.webm" type="video/webm">
                                    <source src="/lanbucket-demo_{{ video }}.mp4" type="video/mp4">
                                </video>
                                <button class="hero-video-play" type="button" aria-label="{% ta %}Play video{% endta %}" hidden>
                                    <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false"><circle cx="50" cy="50" r="50"/><path d="M40 29 L73 50 L40 71 Z"/></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                    {#- Hidden for now
                    <button class="btn btn-demo" onclick="toggleDemo()">▶ See Live Demo</button>

                    <div id="demoContainer" class="demo-container" style="display: none;">
                        <div class="demo-video">
                            <iframe width="560" height="315" src="https://www.youtube.com/embed/S7SLep244ss" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                        </div>
                    </div>
                    #}
                </div>
            </div>
        </section>

        <!-- Performance Section -->
        <section id="performance" class="performance">
            <div class="container">
                <h2 class="section-title">{% t %}Best in class transfer performance{% endt %}</h2>
                <p class="comparison-intro">{% t %}LANBucket uses custom netcode to optimize for the limits of your networking hardware, speeding up your transfers, and saving you time so you can get back to gaming sooner.{% endt %}</p>
                {#- Throughput = 10 GiB (10,737,418,240 bytes) x 8 downloaders = 687,195 megabits, divided by the seconds taken.
                    frac is each bar's length, its throughput over LANBucket's -#}
                {%- set webserver %}{% t %}Standard webserver{% endt %}{% endset -%}
                {%- set perfResults = [
                    { app: "LANBucket", seconds: 120.7, mbps: 5693, frac: "1", highlight: true },
                    { app: "D-LAN", seconds: 229.5, mbps: 2994, frac: "0.5259" },
                    { app: "qBittorrent", seconds: 559.2, mbps: 1229, frac: "0.2159" },
                    { app: webserver, seconds: 724.7, mbps: 948, frac: "0.1665" },
                    { app: "LocalSend", seconds: 726.7, mbps: 946, frac: "0.1662" },
                    { app: "DC++", seconds: 734.3, mbps: 936, frac: "0.1644" }
                ] %}
                <div class="perf-chart">
                    <div class="perf-chart-head">
                        <p class="perf-caption">{% t %}Overall throughput, in Mbps (higher is better){% endt %}</p>
                        <div class="perf-toggle" role="group" aria-label="{% ta %}Chart units{% endta %}">
                            <button type="button" aria-pressed="false" data-mode="seconds" data-unit=" {% ta %}s{% endta %}" data-caption="{% ta %}Time to finish, in seconds (lower is better){% endta %}">{% t %}Time{% endt %}</button>
                            <button type="button" aria-pressed="true" data-mode="mbps" data-unit=" Mbps" data-caption="{% ta %}Overall throughput, in Mbps (higher is better){% endta %}">{% t %}Throughput{% endt %}</button>
                        </div>
                    </div>
                    <ul class="perf-bars" aria-hidden="true">
{%- for r in perfResults %}
                        <li class="perf-row{% if r.highlight %} perf-row-highlight{% endif %}" style="--frac: {{ r.frac }}" data-seconds="{{ r.seconds }}" data-mbps="{{ r.mbps }}" data-tip="{% ta r %}{app}: {seconds} seconds, {mbps} Mbps overall{% endta %}">
                            <span class="perf-label">{{ r.app }}</span>
                            <span class="perf-track"><span class="perf-bar"></span><span class="perf-value">{{ r.mbps | num(locale.code) }} Mbps</span></span>
                        </li>
{%- endfor %}
                    </ul>
                    <div class="sr-only">
                        <table>
                            <caption>{% t %}Time to share a 10 GB file with 8 downloaders, and the overall throughput{% endt %}</caption>
                            <thead>
                                <tr><th scope="col">{% t %}App{% endt %}</th><th scope="col">{% t %}Time to finish{% endt %}</th><th scope="col">{% t %}Overall throughput{% endt %}</th></tr>
                            </thead>
                            <tbody>
{%- for r in perfResults %}
                                <tr><th scope="row">{{ r.app }}</th><td>{% t r %}{seconds} seconds{% endt %}</td><td>{{ r.mbps | num(locale.code) }} Mbps</td></tr>
{%- endfor %}
                            </tbody>
                        </table>
                    </div>
                    <p class="perf-note">{% t %}Test conducted by sharing a 10GB file, containing random test data, to 8 other PCs who all started their downloads simultaneously. All 9 PCs were connected to a consumer gigabit ethernet switch, and were equipped with SSDs. Tested on LANBucket 1.5.0, D-LAN 1.4.0, DC++ 0.884, LocalSend 1.18.2, qBittorrent 5.2.4, and Caddy 2.11.4 as the Webserver.{% endt %}</p>
                </div>
            </div>
        </section>

        <!-- Comparison Section -->
        <section id="comparison" class="comparison">
            <div class="container">
                <h2 class="section-title">{% t %}How LANBucket Compares{% endt %}</h2>
                <div class="comparison-table-wrapper" role="region" aria-label="{% ta %}LANBucket feature comparison{% endta %}" tabindex="0">
                    <table class="comparison-table">
                        <caption class="sr-only">{% t %}Comparison of LANBucket against DC++, D-LAN, LocalSend, SMB shares, cloud storage, Steam local sharing, and a USB flash drive{% endt %}</caption>
                        <thead>
                            <tr>
                                <th scope="col" class="comparison-feature-head">{% t %}Feature{% endt %}</th>
                                <th scope="col" class="comparison-highlight-col">LANBucket</th>
                                <th scope="col">DC++</th>
                                <th scope="col"><span class="no-break">D-LAN</span></th>
                                <th scope="col">LocalSend</th>
                                <th scope="col">{% t %}SMB Share{% endt %}</th>
                                <th scope="col">{% t %}Cloud Storage{% endt %}</th>
                                <th scope="col">{% t %}Steam<sup class="tm-mark">&reg;</sup> Local Sharing{% endt %}</th>
                                <th scope="col">{% t %}Flash Drive{% endt %}</th>
                            </tr>
                        </thead>
                        {#- In a ~ or × cell, the explanation shows as a flyout without its first sentence, the Partial. or No. #}
                        <tbody>
                            <tr>
                                <th scope="row">{% t %}No setup or configuration{% endt %}</th>
                                <td class="comparison-highlight-col cell-yes"><span class="cell-mark" aria-hidden="true">✓</span><span class="sr-only">{% t %}Yes{% endt %}</span></td>
                                <td class="cell-no" tabindex="0"><span class="cell-mark" aria-hidden="true">×</span><span class="sr-only">{% t %}No. DC++ makes you add a hub to connect to and set up your share list before you can use it.{% endt %}</span></td>
                                <td class="cell-partial" tabindex="0"><span class="cell-mark" aria-hidden="true">~</span><span class="sr-only">{% t %}Partial. D-LAN finds peers automatically, but you still choose which folders to share and where downloads go.{% endt %}</span></td>
                                <td class="cell-yes"><span class="cell-mark" aria-hidden="true">✓</span><span class="sr-only">{% t %}Yes{% endt %}</span></td>
                                <td class="cell-no" tabindex="0"><span class="cell-mark" aria-hidden="true">×</span><span class="sr-only">{% t %}No. SMB shares require enabling sharing, setting permissions, and mapping drives.{% endt %}</span></td>
                                <td class="cell-no" tabindex="0"><span class="cell-mark" aria-hidden="true">×</span><span class="sr-only">{% t %}No. You must create an account, install a client, and let it sync before sharing anything.{% endt %}</span></td>
                                <td class="cell-partial" tabindex="0"><span class="cell-mark" aria-hidden="true">~</span><span class="sr-only">{% t %}Partial. You need Steam installed and signed in, plus the relevant sharing setting enabled.{% endt %}</span></td>
                                <td class="cell-no" tabindex="0"><span class="cell-mark" aria-hidden="true">×</span><span class="sr-only">{% t %}No. The drive has to be formatted for your devices and physically plugged into each one.{% endt %}</span></td>
                            </tr>
                            <tr>
                                <th scope="row">{% t %}No account or sign-in required{% endt %}</th>
                                <td class="comparison-highlight-col cell-yes"><span class="cell-mark" aria-hidden="true">✓</span><span class="sr-only">{% t %}Yes{% endt %}</span></td>
                                <td class="cell-yes"><span class="cell-mark" aria-hidden="true">✓</span><span class="sr-only">{% t %}Yes{% endt %}</span></td>
                                <td class="cell-yes"><span class="cell-mark" aria-hidden="true">✓</span><span class="sr-only">{% t %}Yes{% endt %}</span></td>
                                <td class="cell-yes"><span class="cell-mark" aria-hidden="true">✓</span><span class="sr-only">{% t %}Yes{% endt %}</span></td>
                                <td class="cell-no" tabindex="0"><span class="cell-mark" aria-hidden="true">×</span><span class="sr-only">{% t %}No. SMB on Windows needs valid user credentials to authenticate access.{% endt %}</span></td>
                                <td class="cell-no" tabindex="0"><span class="cell-mark" aria-hidden="true">×</span><span class="sr-only">{% t %}No. Cloud storage requires creating and signing into an account before you can transfer files.{% endt %}</span></td>
                                <td class="cell-no" tabindex="0"><span class="cell-mark" aria-hidden="true">×</span><span class="sr-only">{% t %}No. You must have a Steam account and be signed in to use any Steam feature.{% endt %}</span></td>
                                <td class="cell-yes"><span class="cell-mark" aria-hidden="true">✓</span><span class="sr-only">{% t %}Yes{% endt %}</span></td>
                            </tr>
                            <tr>
                                <th scope="row">{% t %}Distributed (many-to-many) transfers{% endt %}</th>
                                <td class="comparison-highlight-col cell-yes"><span class="cell-mark" aria-hidden="true">✓</span><span class="sr-only">{% t %}Yes{% endt %}</span></td>
                                <td class="cell-partial" tabindex="0"><span class="cell-mark" aria-hidden="true">~</span><span class="sr-only">{% t %}Partial. DC++ can pull a file from several peers at once, but only once the other peer has completed the download. LANBucket allows downloading from peers who don't have the complete file.{% endt %}</span></td>
                                <td class="cell-yes"><span class="cell-mark" aria-hidden="true">✓</span><span class="sr-only">{% t %}Yes{% endt %}</span></td>
                                <td class="cell-no" tabindex="0"><span class="cell-mark" aria-hidden="true">×</span><span class="sr-only">{% t %}No. LocalSend sends directly from one device to another, one transfer at a time.{% endt %}</span></td>
                                <td class="cell-no" tabindex="0"><span class="cell-mark" aria-hidden="true">×</span><span class="sr-only">{% t %}No. An SMB share is served by a single host, so everyone downloads from that one machine.{% endt %}</span></td>
                                <td class="cell-no" tabindex="0"><span class="cell-mark" aria-hidden="true">×</span><span class="sr-only">{% t %}No. Transfers go through the provider's servers rather than directly between many local peers.{% endt %}</span></td>
                                <td class="cell-no" tabindex="0"><span class="cell-mark" aria-hidden="true">×</span><span class="sr-only">{% t %}No. Content comes from a single host, not many peers sharing the load.{% endt %}</span></td>
                                <td class="cell-no" tabindex="0"><span class="cell-mark" aria-hidden="true">×</span><span class="sr-only">{% t %}No. A flash drive is copied to one machine at a time by hand.{% endt %}</span></td>
                            </tr>
                            <tr>
                                <th scope="row">{% t %}Automatic peer discovery{% endt %}</th>
