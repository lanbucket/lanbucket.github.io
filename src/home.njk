        </section>
    </main>

{% include "footer.njk" %}

    <script>
        function toggleDemo() {
            const demoContainer = document.getElementById('demoContainer');
            if (demoContainer.style.display === 'none') {
                demoContainer.style.display = 'block';
            } else {
                demoContainer.style.display = 'none';
            }
        }

        // The current version under the Store badge and the setup button's link, from the update feed the release
        // workflow publishes. The version's line is held blank until then, so nothing moves when it fills in. The
        // installer's file name carries the version, so the button links to the download page until the feed loads
        const heroVersion = document.getElementById('heroVersion');
        const heroSetup = document.getElementById('heroSetup');
        fetch('/app/latest.json', { cache: 'no-cache' })
            .then((response) => (response.ok ? response.json() : Promise.reject(new Error(response.status))))
            .then((latest) => {
                // MSIX versions have four parts; the changelog leaves off a trailing .0
                if (heroVersion && latest.version) heroVersion.textContent = heroVersion.dataset.label.replace('{version}', latest.version.replace(/^(\d+\.\d+\.\d+)\.0$/, '$1'));
                if (heroSetup && latest.setupUrl) {
                    heroSetup.href = latest.setupUrl;
                    heroSetup.setAttribute('download', '');
                }
            })
            .catch(() => {});

        // Big play button over the hero video; the native controls take over once it starts
        const heroVideo = document.querySelector('.hero-video');
        const heroPlay = document.querySelector('.hero-video-play');
        if (heroVideo && heroPlay) {
            heroVideo.controls = false;
            heroPlay.hidden = false;
            heroPlay.addEventListener('click', () => {
                heroVideo.controls = true;
                heroVideo.play();
            });
            heroVideo.addEventListener('play', () => { heroPlay.hidden = true; });
            heroVideo.addEventListener('ended', () => {
                heroVideo.controls = false;
                heroVideo.load(); // back to the poster frame
                heroPlay.hidden = false;
            });
        }

{% include "nav-script.njk" %}


        // Performance chart: switch the bars between time and throughput
        const perfChart = document.querySelector('.perf-chart');
        if (perfChart) {
            const perfRows = perfChart.querySelectorAll('.perf-row');
            const perfCaption = perfChart.querySelector('.perf-caption');
            const perfButtons = perfChart.querySelectorAll('.perf-toggle button');
            // Western digits on every page, the same as the numbers the page was built with
            const perfNumber = new Intl.NumberFormat(document.documentElement.lang, { numberingSystem: 'latn', maximumFractionDigits: 1 });

            const setPerfMode = (button) => {
                const key = button.dataset.mode;
                const max = Math.max(...Array.from(perfRows, (row) => Number(row.dataset[key])));
                perfRows.forEach((row) => {
                    const value = Number(row.dataset[key]);
                    row.style.setProperty('--frac', value / max);
                    row.querySelector('.perf-value').textContent = perfNumber.format(value) + button.dataset.unit;
                });
                perfButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
                perfCaption.textContent = button.dataset.caption;
            };

            perfButtons.forEach((button) => button.addEventListener('click', () => setPerfMode(button)));
        }

        // Comparison flyouts explaining partial/unsupported cells and the performance chart bars
        const comparisonTable = document.querySelector('.comparison-table');
        if (comparisonTable) {
            const tipCells = document.querySelectorAll('.comparison-table td.cell-no, .comparison-table td.cell-partial, .perf-row');
            if (tipCells.length) {
                const tooltip = document.createElement('div');
                tooltip.className = 'comparison-tooltip';
                tooltip.setAttribute('role', 'tooltip');
                tooltip.hidden = true;
                document.body.appendChild(tooltip);

                let activeCell = null;

                const positionTooltip = () => {
                    if (!activeCell) return;
                    const rect = (activeCell.querySelector('.perf-bar') || activeCell).getBoundingClientRect();
                    const tipRect = tooltip.getBoundingClientRect();
                    const margin = 8;

                    let left = rect.left + rect.width / 2 - tipRect.width / 2;
                    left = Math.max(margin, Math.min(left, window.innerWidth - tipRect.width - margin));

                    let top = rect.top - tipRect.height - 10;
                    let placement = 'top';
                    if (top < margin) {
                        top = rect.bottom + 10;
                        placement = 'bottom';
                    }

                    tooltip.style.left = left + 'px';
                    tooltip.style.top = top + 'px';
                    tooltip.dataset.placement = placement;
                    tooltip.style.setProperty('--arrow-left', (rect.left + rect.width / 2 - left) + 'px');
                };

                const showTooltip = (cell) => {
                    // A cell's screen reader text starts with a short "Partial." or "No." sentence (in any
                    // language, so ending in any of these marks; see STATUS_SENTENCE in scripts/i18n-keys.mjs), which
                    // the cell's mark already shows
                    const text = cell.dataset.tip
                        ? cell.dataset.tip.trim()
                        : cell.querySelector('.sr-only')?.textContent.trim().replace(/^[^.。．।۔:：]{1,20}[.。．।۔:：]\s*/u, '');
                    if (!text) return;
                    activeCell = cell;
                    tooltip.textContent = text;
                    tooltip.hidden = false;
                    positionTooltip();
                    requestAnimationFrame(() => tooltip.classList.add('is-visible'));
                };

                const hideTooltip = () => {
                    activeCell = null;
                    tooltip.classList.remove('is-visible');
                    tooltip.hidden = true;
                };

                tipCells.forEach((cell) => {
                    cell.addEventListener('mouseenter', () => showTooltip(cell));
                    cell.addEventListener('mouseleave', hideTooltip);
                    cell.addEventListener('focus', () => showTooltip(cell));
                    cell.addEventListener('blur', hideTooltip);
                });

                window.addEventListener('scroll', () => { if (activeCell) positionTooltip(); }, true);
                window.addEventListener('resize', hideTooltip);
                document.addEventListener('keydown', (event) => {
                    if (event.key === 'Escape') hideTooltip();
                });
            }
        }
    </script>
</body>
</html>
