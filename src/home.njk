                                <td class="cell-no" tabindex="0"><span class="cell-mark" aria-hidden="true">×</span><span class="sr-only">{% t %}No. D-LAN transfers files without any automatic compression.{% endt %}</span></td>
                                <td class="cell-no" tabindex="0"><span class="cell-mark" aria-hidden="true">×</span><span class="sr-only">{% t %}No. LocalSend transfers files without any automatic compression.{% endt %}</span></td>
                                <td class="cell-no" tabindex="0"><span class="cell-mark" aria-hidden="true">×</span><span class="sr-only">{% t %}No. SMB transfers files without any automatic compression.{% endt %}</span></td>
                                <td class="cell-no" tabindex="0"><span class="cell-mark" aria-hidden="true">×</span><span class="sr-only">{% t %}No. Cloud transfers files without any automatic compression.{% endt %}</span></td>
