---
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.path }}index.html"
---
{%- set subpath = "" -%}
{%- set navPage = "home" -%}
{%- set notEn = locale.code != "en" -%}
{#- Links to pages that are only in English say so on the other languages' pages -#}
{%- set enOnly = ' hreflang="en"' if notEn else "" -%}
{%- set video = locale.video or "en-US" -%}
<!DOCTYPE html>
<html lang="{{ locale.code }}"{% if locale.dir %} dir="{{ locale.dir }}"{% endif %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Primary Meta Tags -->
